<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_sales_report_wizard_form" model="ir.ui.view">
        <field name="name">product.sales.report.wizard.form</field>
        <field name="model">product.sales.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Sales Report">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="period_type" widget="radio"/>
                    <field name="report_date" invisible="period_type == 'custom'" required="period_type != 'custom'"/>
                    <field name="date_from" invisible="period_type != 'custom'" required="period_type == 'custom'"/>
                    <field name="date_to" invisible="period_type != 'custom'" required="period_type == 'custom'"/>
                </group>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_sales_report_wizard" model="ir.actions.act_window">
        <field name="name">Product Sales Report</field>
        <field name="res_model">product.sales.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_product_sales_report"
              name="Product Sales Report"
              parent="sale.sale_menu_root"
              action="action_product_sales_report_wizard"
              sequence="95"
              groups="sales_team.group_sale_salesman"/>
</odoo>
