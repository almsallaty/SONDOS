<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_product_sales_report" model="report.paperformat">
        <field name="name">Product Sales Report A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_product_sales_report" model="ir.actions.report">
        <field name="name">Product Sales Report</field>
        <field name="model">product.sales.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_daily_product_report.product_sales_report_document</field>
        <field name="report_file">sale_daily_product_report.product_sales_report_document</field>
        <field name="paperformat_id" ref="paperformat_product_sales_report"/>
        <field name="print_report_name">'Product Sales Report - %s' % (object.report_date or object.date_from or '')</field>
    </record>
</odoo>
